{
  "name": "@odigos/instrumentation-bunyan",
  "version": "1.0.0",
  "description": "OpenTelemetry instrumentation for `bunyan` logger",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "repository": "odigos-io/instrumentation-bunyan",
  "scripts": {
    "test": "mocha --require @opentelemetry/contrib-test-utils 'test/**/*.test.ts'",
    "tdd": "npm run test -- --watch-extensions ts --watch",
    "clean": "rimraf build/*",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:readme": "node ../../../scripts/lint-readme",
    "prewatch": "npm run precompile",
    "prepublishOnly": "npm run compile",
    "version:update": "node ../../../scripts/version-update.js",
    "compile": "tsc -p ."
  },
  "keywords": [
    "bunyan",
    "instrumentation",
    "logging",
    "nodejs",
    "opentelemetry",
    "profiling",
    "tracing"
  ],
  "author": "Amir Blum",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "build/src/**/*.js",
    "build/src/**/*.js.map",
    "build/src/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.3.0",
    "@opentelemetry/resources": "^1.8.0",
    "@opentelemetry/sdk-logs": "^0.52.0",
    "@opentelemetry/sdk-trace-base": "^1.24.0",
    "@opentelemetry/sdk-trace-node": "^1.8.0",
    "@opentelemetry/semantic-conventions": "^1.23.0",
    "@types/mocha": "7.0.2",
    "@types/node": "18.18.14",
    "@types/sinon": "^10.0.11",
    "bunyan": "1.8.15",
    "mocha": "7.2.0",
    "nyc": "15.1.0",
    "rimraf": "5.0.10",
    "sinon": "15.2.0",
    "typescript": "4.4.4"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.52.0",
    "@opentelemetry/instrumentation": "^0.54.0",
    "@types/bunyan": "1.8.9"
  },
  "homepage": "https://github.com/odigos-io/instrumentation-bunyan#readme"
}

